<?xml version="1.0" encoding="utf-8"?>
<!--
  AirFree aurora backdrop. A low-amplitude sky -> violet diagonal gradient
  painted behind the glass surfaces so the whole window reads as one ambient
  surface. Text never sits directly on it without a glass card behind it
  (contrast is measured on the composed surface).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/af_gradient_top"
        android:centerColor="@color/af_gradient_mid"
        android:endColor="@color/af_gradient_bottom"
        android:type="linear" />
</shape>
