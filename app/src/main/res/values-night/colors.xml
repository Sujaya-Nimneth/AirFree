<?xml version="1.0" encoding="utf-8"?>
<!--
  AirFree night-mode color overrides. Ported 1:1 from
  assets/design-tokens.json (dark column) / design/airfree.theme.ts.

  Only colors that need to differ between day and night live here; add a
  token to values/colors.xml FIRST so the fallback always resolves.

  Layering: page #0B1020 (darkest), glass cards #1B2440AD (translucent,
  one step up), chips #16203A. Hairlines flip to white at low alpha so
  they stay visible on dark surfaces. Pure black is avoided to prevent
  OLED smear during scrolls and sheet animations.
-->
<resources>
    <!-- Semantic brand tokens (dark). -->
    <color name="af_primary">#FF7DA9FF</color>
    <color name="af_primary_strong">#FF4C7DF0</color>
    <color name="af_aurora">#FFA78BFA</color>
    <color name="af_cta">#FFFBBF24</color>
    <color name="af_on_cta">#FF0B1020</color>
    <color name="af_gradient_top">#FF4C7DF0</color>
    <color name="af_gradient_bottom">#FFA78BFA</color>
    <color name="af_success">#FF4ADE80</color>
    <color name="af_error">#FFF87171</color>
    <color name="af_glass_border">#24FFFFFF</color>
    <color name="af_focus_ring">#FF7DA9FF</color>

    <!-- Legacy-named tokens retained for drawable/layout resolution. -->
    <color name="brand_primary">#FF7DA9FF</color>
    <color name="nav_surface">#AD1B2440</color>
    <color name="nav_item_active">#FF7DA9FF</color>
